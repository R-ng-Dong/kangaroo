#
# ESP32-C3 (single-core RISC-V, BLE 5.0) specific settings
#

# Target - so a clean configure picks esp32c3 without `idf.py set-target`
CONFIG_IDF_TARGET="esp32c3"

# Flash size for esp32c3
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ── BT Controller ──────────────────────────────────────────────────────────────
CONFIG_BT_CTRL_MODE_EFF=1
# One legacy connectable advertising set plus one connection. Extended
# advertising is off, so the controller never needs the wider activity budget
# (and the NimBLE handle arrays are sized MAX_CONNECTIONS + 1).
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_PINNED_TO_CORE=0
CONFIG_BT_CTRL_HCI_MODE_VHCI=y
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P9=y

# ── BLE 5.0 features ──────────────────────────────────────────────────────────
# The provisioning profile is legacy advertising only (the reference product
# sets none of these). Extended/periodic scanning needs the observer role,
# which is disabled.
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
# CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_2M_PHY is not set
# CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_CODED_PHY is not set
# CONFIG_BT_NIMBLE_EXT_SCAN is not set
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC is not set

# ── Flash header update (C3 needs this for flashing) ──────────────────────────
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
